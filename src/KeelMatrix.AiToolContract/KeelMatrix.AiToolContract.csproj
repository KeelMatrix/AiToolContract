<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <IsShippingProject>true</IsShippingProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>KeelMatrix.AiToolContract</PackageId>
    <Version>0.1.0-rc.1</Version>
    <Authors>KeelMatrix</Authors>
    <Company>KeelMatrix</Company>
    <Description>Baseline and compatibility-check the model-visible contracts of Microsoft.Extensions.AI tools.</Description>
    <PackageTags>ai;microsoft-extensions-ai;aifunction;function-calling;tool-calling;json-schema;testing;compatibility</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('../../icon.png')">icon.png</PackageIcon>
    <PackageReleaseNotes>Initial release candidate.</PackageReleaseNotes>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);NU5046</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" Condition="Exists('../../icon.png')" />
    <SourceLinkGitHubRepository Include="KeelMatrix/AiToolContract" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeelMatrix.AiToolContract.Tests" />
  </ItemGroup>
</Project>
