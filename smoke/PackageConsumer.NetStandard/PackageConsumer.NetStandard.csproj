<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <AiToolContractConsumerVersion Condition="'$(AiToolContractConsumerVersion)' == ''">0.1.0-rc.1</AiToolContractConsumerVersion>
    <AiToolContractConsumerAbstractionsVersion Condition="'$(AiToolContractConsumerAbstractionsVersion)' == ''">10.10.0</AiToolContractConsumerAbstractionsVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KeelMatrix.AiToolContract" Version="$(AiToolContractConsumerVersion)" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="$(AiToolContractConsumerAbstractionsVersion)" />
  </ItemGroup>
</Project>
